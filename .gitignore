# Terraform working directories
.terraform/
**/.terraform/
.terraform-tmp/
**/.terraform-tmp/

# Terraform state must never be committed
*.tfstate
*.tfstate.*

# Local remote-state bootstrap configuration
bootstrap/remote-state/terraform.tfvars

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files may contain sensitive values
tfplan
tfplan-*
*.tfplan
*.tfplan.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files can contain local-only credentials or paths
.terraformrc
terraform.rc

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep .terraform.lock.hcl committed for reproducible provider selections.
